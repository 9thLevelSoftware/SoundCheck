{
  "name": "soundcheck-backend",
  "version": "1.0.1",
  "description": "Backend API for SoundCheck mobile application",
  "main": "dist/index.js",
  "packageManager": "npm@11.14.1",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "build": "node node_modules/typescript/lib/tsc.js && node node_modules/typescript/lib/tsc.js -p tsconfig.migrations.json && node scripts/copy-runtime-assets.mjs && node dist/scripts/validateRuntimeAssets.js",
    "migrate": "node-pg-migrate -j js --migrations-dir ./dist/migrations --database-url-var DATABASE_URL",
    "migrate:up": "npm run migrate up",
    "migrate:down": "npm run migrate down",
    "migrate:deploy": "node dist/scripts/migrateDeploy.js",
    "migrate:create": "npm run migrate create",
    "seed": "ts-node src/scripts/seed.ts",
    "seed:demo": "ts-node src/scripts/seed-demo.ts",
    "seed:dev": "NODE_ENV=development ts-node src/scripts/seed.ts",
    "retention-job": "ts-node src/scripts/retentionJob.ts",
    "test": "jest --maxWorkers=4",
    "test:watch": "jest --watch --maxWorkers=4",
    "test:coverage": "jest --coverage --maxWorkers=4",
    "test:http-contracts": "node scripts/verify-http-contracts.mjs",
    "test:postgres:integration": "jest --runInBand --detectOpenHandles src/__tests__/services/CheckinService.integration.test.ts",
    "test:migrations:integration": "node scripts/verify-migrations.cjs",
    "test:dependency-compatibility": "node --test scripts/__tests__/brace-glob-compatibility.test.cjs",
    "test:runtime-assets": "node scripts/verify-built-runtime.cjs",
    "test:startup:unhealthy": "node scripts/verify-unhealthy-startup.cjs",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --fix --max-warnings 0"
    ]
  },
  "keywords": [
    "music",
    "venues",
    "bands",
    "reviews",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1048.0",
    "@aws-sdk/s3-request-presigner": "^3.1048.0",
    "@google-cloud/vision": "^5.3.7",
    "@resvg/resvg-js": "^2.6.2",
    "@sentry/node": "^10.68.0",
    "@types/multer": "^2.1.0",
    "apple-signin-auth": "^2.0.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.9",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.20.0",
    "resend": "^6.12.3",
    "satori": "^0.26.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.12.4",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.5",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "google-gax": {
      "rimraf": "6.1.3"
    },
    "uuid": "^11.1.1",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "moment": "2.31.0",
    "fflate": "0.7.5",
    "@grpc/grpc-js": "1.14.5",
    "@fastify/busboy": "3.2.2",
    "minimatch@10": {
      "brace-expansion": "5.0.12"
    }
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.jest.json"
        }
      ]
    },
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 50,
        "functions": 50,
        "lines": 60,
        "statements": 60
      }
    },
    "setupFilesAfterEnv": [
      "<rootDir>/src/__tests__/setup.ts"
    ]
  }
}
