  "findings": [
    {
      "id": "RA-001",
      "severity": "P0",
      "area": "backend",
      "feature": "rate limiting",
      "evidence": "Shared Redis key rate_limit:<ip> makes login 429 after catalog GETs. auth.ts:291, redisRateLimiter.ts:99-141. Smoke: 6x GET /api/venues then login = 429.",
      "acceptance": "Login succeeds after 20 catalog reads from the same IP. Auth routes keep their own 5/15m ceiling.",
      "wave": "wave-1",
      "historicalIds": [
        "API-061"
      ]
    },
    {
      "id": "RA-002",
      "severity": "P0",
      "area": "mobile+api",
      "feature": "profiles",
      "evidence": "GET /users/:uuid 404s because the route is username lookup. block_providers.dart:38-45, UserController.ts:129-153. User.fromJson also requires email/isActive/updatedAt which the public payload omits.",
      "acceptance": "GET /api/users/<uuid> returns a public profile the mobile User model parses. Widget test covers another user profile.",
      "wave": "wave-1",
      "historicalIds": []
    },
    {
      "id": "RA-003",
      "severity": "P0",
      "area": "backend",
      "feature": "privacy export and consent",
      "evidence": "userRoutes catch-all /:username is mounted before export and consents. index.ts:352 then 364-365, userRoutes.ts:277. Smoke token GETs returned 404 User not found.",
      "acceptance": "Authenticated /api/users/export and /api/users/consents return 200 and a supertest asserts they are not username lookups.",
      "wave": "wave-1",
      "historicalIds": []
    },
    {
      "id": "RA-004",
      "severity": "P0",
      "area": "security",
      "feature": "secrets",
      "evidence": "CHANGELOG.md:23 commits a setlist.fm API key.",
      "acceptance": "Key removed from tree and history, rotated at the provider, docs use a placeholder.",
      "wave": "wave-1",
      "historicalIds": []
    },
    {
      "id": "RA-005",
      "severity": "P1",
      "area": "backend",
      "feature": "login",
      "evidence": "Bad password throws plain Error (AuthService.ts:82-92) and becomes HTTP 500 (index.ts:421-450). Smoke production login returned 500.",
      "acceptance": "Wrong password returns 401 canonical envelope. Controller test covers it.",
      "wave": "wave-2",
      "historicalIds": []
    },
    {
      "id": "RA-006",
      "severity": "P1",
      "area": "backend",
      "feature": "check-in and events",
