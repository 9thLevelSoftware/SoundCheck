    {
      "id": "RA-009",
      "severity": "P1",
      "area": "privacy",
      "feature": "policy vs SDKs",
      "evidence": "Policy promises likes, reviews, in-app privacy controls, and export. App ships Sentry, Firebase Analytics/Messaging, RevenueCat, toasts, and local-only settings toggles. Export UI is absent and the route is RA-003. Address is a placeholder.",
      "acceptance": "Policy names shipped processors and matches product behavior, including a working export or no export promise.",
      "wave": "wave-3",
      "historicalIds": []
