      "area": "mobile+api",
      "feature": "manual check-in rating",
      "evidence": "Manual flow sends rating (checkin_screen.dart:814-825) but INSERT hardcodes 0 (CheckinCreatorService.ts:150). Smoke rating 4.5 stored as 0. Notes did persist as noteText.",
      "acceptance": "Manual rating is stored, or the client patches /ratings before leaving the flow. Test fails if rating stays 0.",
      "wave": "wave-2",
      "historicalIds": []
    },
    {
      "id": "RA-008",
      "severity": "P1",
      "area": "backend",
      "feature": "account deletion",
